{
  "name": "fis-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute fis-backend --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute fis-backend --remote --file=migrations/0001_init.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
