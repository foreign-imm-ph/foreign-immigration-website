        "gateDataKey": "courtLegalApplies",
        "fields": [
          "courtName",
          "courtBranchPlace",
          "courtContactNumber"
        ],
        "fallbackValue": "N/A"
      }
    ],
    "repeatableGroups": [
      {
        "dataKey": "trips",
        "maxCount": 3,
        "subFields": [
          "arrivalDay",
          "arrivalMonth",
          "arrivalYear",
          "arrivalFlight",
          "departureDay",
          "departureMonth",
          "departureYear",
          "departureFlight"
