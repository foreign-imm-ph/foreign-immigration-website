        <ul>
          <li>Assessing your circumstances against the long-term status options available</li>
          <li>Preparing and organising the required documentation</li>
          <li>Managing the application and liaison with the relevant authority</li>
          <li>Advising on the ongoing obligations associated with long-term status</li>
        </ul>
      </div>
      <div class="media-split__media">
        {{ mediaPanel("residency-status", "wide") }}
