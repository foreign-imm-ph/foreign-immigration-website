{#- Language selector. Pure HTML <details>/<summary> (the same no-JS
   disclosure pattern already used by the FAQ component elsewhere on the
   site) — works with no JavaScript, opens/closes with native keyboard
   support (Enter/Space on the summary, Tab through the links), and is
   announced correctly by screen readers without any extra ARIA scripting.
   Sits inside .site-nav so it collapses into the same mobile menu as the
   rest of primary navigation rather than needing a second toggle.

   Only locales marked "active" in site.json are listed (the activeLocales
   filter) — a "sample" locale stays fully built and reachable by typing
   its URL directly for review, but is never linked to from here, so this
   component alone never leaks an unfinished translation into production
   navigation. If fewer than two locales are active (today: just English),
   there is nothing to switch to, so the whole control is omitted rather
   than rendering a single-option dropdown. #}
{%- set active = site.locales | activeLocales %}
{%- if active.length > 1 %}
<details class="lang-switcher">
  <summary class="lang-switcher__toggle" aria-label="{{ 'languageSwitcher.label' | t(lang) }}">
    <span aria-hidden="true">{{ site.locales[lang].nativeLabel }}</span>
  </summary>
  <ul class="lang-switcher__list">
    {%- for loc in active %}
    {%- set target = collections.all | equivalentUrl(translationKey, loc.code) %}
    {%- set href = target or loc.prefix %}
    <li>
      <a href="{{ href }}" lang="{{ loc.code }}" hreflang="{{ loc.code }}"{% if loc.code == lang %} aria-current="true"{% endif %}>
        {{ loc.nativeLabel }}
      </a>
    </li>
    {%- endfor %}
  </ul>
</details>
{%- endif %}
