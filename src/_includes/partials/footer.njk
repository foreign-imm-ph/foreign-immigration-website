<footer class="site-footer">
  <div class="site-footer__brand-panel">
    <div class="wrap site-footer__brand-inner">
      <img class="site-footer__logo" src="/assets/images/fis-logo.svg" alt="{{ site.name }}" width="1342" height="894">
      <p class="site-footer__accreditation">
        {{ ("footer.brandLine" | t(lang)) | replace("{number}", site.accreditation.number) | safe }}
      </p>
    </div>
  </div>

  <div class="site-footer__legal-panel">
    <div class="wrap site-footer__legal-inner">
      <div class="site-footer__col">
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      </div>

      <nav class="site-footer__col" aria-label="Legal">
        <ul>
          {%- for path in ["/privacy-notice/", "/terms-of-use/", "/accessibility/"] %}
          {%- set legalKey = { "/privacy-notice/": "footer.privacyNotice", "/terms-of-use/": "footer.termsOfUse", "/accessibility/": "footer.accessibility" }[path] %}
          {%- set legalUrl = (collections.all | equivalentUrl(path, lang)) or path %}
          {%- set legalLang = "en" if legalUrl == path else lang %}
          <li><a href="{{ legalUrl }}" lang="{{ legalLang }}" hreflang="{{ legalLang }}">{{ legalKey | t(lang) }}</a></li>
          {%- endfor %}
        </ul>
      </nav>
    </div>

    <div class="wrap site-footer__legal">
      <p>&copy; {{ currentYear }} {{ site.name }}. {{ "footer.rightsReserved" | t(lang) }}</p>
    </div>
  </div>
</footer>
