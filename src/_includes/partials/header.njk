<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__brand" href="/">
      <img class="site-header__logo" src="/assets/images/fis-logo.png" alt="{{ site.name }}" width="612" height="408">
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle">
    <label for="nav-toggle" class="nav-toggle__label" aria-label="Open menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {%- for item in nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
