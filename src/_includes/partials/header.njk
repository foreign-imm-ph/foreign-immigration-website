<header class="site-header">
  <div class="wrap site-header__inner">
    <div class="site-header__left">
      <a class="site-header__brand" href="/">
        <img class="site-header__logo" src="/assets/images/fis-logo.svg" alt="{{ site.name }}" width="1342" height="894">
      </a>
      <p class="site-header__credential"><strong>BI Accredited Consultancy</strong> · No. {{ site.accreditation.number }}</p>
    </div>

    <input type="checkbox" id="nav-toggle" class="nav-toggle">
    <label for="nav-toggle" class="nav-toggle__label" aria-label="Open menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {%- for item in nav %}
        <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>
