<header class="site-header">
  <div class="wrap site-header__inner">
    <div class="site-header__left">
      <a class="site-header__brand" href="/">
        <img class="site-header__logo" src="/assets/images/fis-logo.svg" alt="{{ site.name }}" width="1342" height="894">
      </a>
      <p class="site-header__credential">{{ ("header.credential" | t(lang)) | replace("{number}", site.accreditation.number) | safe }}</p>
    </div>

    <input type="checkbox" id="nav-toggle" class="nav-toggle">
    <label for="nav-toggle" class="nav-toggle__label" aria-label="Open menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {%- for item in nav %}
        {%- set navUrl = (collections.all | equivalentUrl(item.url, lang)) or item.url %}
        <li><a href="{{ navUrl }}"{% if page.url == navUrl %} aria-current="page"{% endif %}>{{ ("nav." + item.key) | t(lang) }}</a></li>
        {%- endfor %}
      </ul>
      {% include "partials/language-switcher.njk" %}
    </nav>
  </div>
</header>
