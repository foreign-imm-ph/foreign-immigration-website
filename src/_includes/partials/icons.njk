{#
  Original line-style icon system for Foreign Immigration Services.
  All paths authored directly for this site (no third-party icon library).
  Two-tone: primary strokes use currentColor (set by the wrapping element),
  small accent details use the brand gold directly. Purely decorative —
  callers must wrap with aria-hidden="true" (done by the icon() macro).
#}
{%- macro icon(name, size=24) -%}
<span class="icon icon--{{ size }}" aria-hidden="true" focusable="false">
{%- if name == "visa-applications" %}
<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
  <rect x="8" y="7" width="23" height="34" rx="3"/>
  <line x1="19.5" y1="7" x2="19.5" y2="41"/>
  <line x1="13" y1="16" x2="16" y2="16"/>
  <line x1="13" y1="21" x2="16" y2="21"/>
  <line x1="13" y1="26" x2="16" y2="26"/>
  <circle cx="35" cy="16" r="7" stroke="var(--color-gold)"/>
  <path d="M31.7 16.2l2 2.2 3.6-4.4" stroke="var(--color-gold)"/>
</svg>
{%- elif name == "extensions-compliance" %}
<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
  <path d="M22 6l14 5v11c0 10-6 16-14 20-8-4-14-10-14-20V11z"/>
  <line x1="16" y1="21" x2="28" y2="21"/>
  <line x1="16" y1="27" x2="24" y2="27"/>
  <circle cx="34" cy="33" r="8" fill="var(--color-offwhite)" stroke="var(--color-gold)"/>
  <line x1="34" y1="33" x2="34" y2="28.5" stroke="var(--color-gold)"/>
  <line x1="34" y1="33" x2="37" y2="34.5" stroke="var(--color-gold)"/>
</svg>
{%- elif name == "residency-status" %}
<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
  <rect x="5" y="13" width="34" height="24" rx="3"/>
  <circle cx="15" cy="25" r="5"/>
  <line x1="24" y1="20" x2="33" y2="20"/>
  <line x1="24" y1="25" x2="33" y2="25"/>
  <line x1="24" y1="30" x2="30" y2="30"/>
  <path d="M35 6l6 5.5v0.5h-2v6h-8v-6h-2v-0.5z" stroke="var(--color-gold)" stroke-linejoin="round"/>
</svg>
{%- elif name == "corporate-mobility" %}
<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
  <circle cx="20" cy="19" r="13"/>
  <ellipse cx="20" cy="19" rx="5.5" ry="13"/>
  <line x1="7" y1="19" x2="33" y2="19"/>
  <path d="M9 12c4 2.5 18 2.5 22 0" stroke-width="1.6"/>
  <path d="M9 26c4-2.5 18-2.5 22 0" stroke-width="1.6"/>
  <rect x="26" y="28" width="16" height="12" rx="2" fill="var(--color-offwhite)" stroke="var(--color-gold)"/>
  <path d="M31 28v-3a3 3 0 013-3h0a3 3 0 013 3v3" stroke="var(--color-gold)"/>
</svg>
{%- elif name == "status-review" %}
<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round">
